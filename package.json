{
  "name": "daydreamer",
  "description": "Daydreamer is a reusable datepicker component for React.",
  "main": "dist/daydreamer.js",
  "module": "dist/daydreamer.js",
  "types": "dist/daydreamer.d.ts",
  "exports": {
    ".": {
      "import": "./dist/daydreamer.js",
      "require": "./dist/daydreamer.cjs"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaarslan/daydreamer.git"
  },
  "keywords": [
    "datepicker",
    "calendar",
    "react",
    "daydreamer"
  ],
  "author": "A. Arslan",
  "license": "MIT",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --p ./tsconfig-build.json && vite build",
    "lint": "biome check --write lib/*"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "terser": "^5.43.1",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
